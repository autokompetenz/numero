# =============================================================================
# Numivo — modèle de configuration locale
# Copier ce fichier en `.env` puis renseigner les valeurs.
# Le fichier `.env` est ignoré par Git. Ne jamais committer de secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
# development | test | staging | production
# `staging` autorise les fournisseurs simulés et les outils /api/dev/*.
APP_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Origines autorisées pour le navigateur, séparées par des virgules.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Nombre de proxys de confiance devant l'API (0 en local, 1 sur Vercel).
TRUST_PROXY=0

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
# PostgreSQL local : adapter utilisateur, mot de passe et port.
DATABASE_URL=postgresql://numivo:numivo_dev_password@127.0.0.1:5432/numivo?schema=public

# Connexion directe utilisée par Prisma Migrate.
# Obligatoire sur Vercel/Neon : même URL sans `-pooler` dans l'hôte.
# En local, laisser vide pour réutiliser DATABASE_URL.
DIRECT_URL=

# -----------------------------------------------------------------------------
# Authentification
# -----------------------------------------------------------------------------
# Générer avec : openssl rand -hex 64
JWT_ACCESS_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_OCTETS_MINIMUM
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# En production avec HTTPS : true. En local HTTP : false.
COOKIE_SECURE=false

# Compte administrateur initial (créé par le seed uniquement s'il n'existe pas).
ADMIN_EMAIL=admin@numivo.local
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
ADMIN_NAME=Administrateur Numivo
ADMIN_COUNTRY=Bénin

# -----------------------------------------------------------------------------
# Ultra SMS — fournisseur de numéros virtuels
# Documentation : https://ultrasmsin.com/reseller/docs
# -----------------------------------------------------------------------------
# mock = simulation (autorisée hors environnement live)
# live = appels réels à l'API Ultra SMS (débite le solde du compte)
ULTRASMS_MODE=mock
ULTRASMS_API_KEY=
ULTRASMS_BASE_URL=https://ultrasmsin.com/api/v1
# Secret whsec_... affiché lors de l'enregistrement du callback dans le compte.
ULTRASMS_WEBHOOK_SECRET=
# URL publique HTTPS du callback (laisser vide en local).
ULTRASMS_CALLBACK_URL=
# Délai de simulation d'un SMS en mode mock (ms). Ignoré en live.
ULTRASMS_MOCK_SMS_DELAY_MS=12000
# Fréquence de vérification des commandes en cours (ms).
ULTRASMS_POLL_INTERVAL_MS=10000

# -----------------------------------------------------------------------------
# Paiements — FedaPay
# Tableau de bord : https://dashboard.fedapay.com
# Documentation : https://docs.fedapay.com
# -----------------------------------------------------------------------------
# sandbox = transactions de test FedaPay
# live    = transactions réelles
# mock    = simulation (autorisée hors environnement live, aucune clé requise)
PAYMENTS_MODE=mock
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# Secret du webhook (dashboard FedaPay > Webhooks).
FEDAPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Poller planifié
# -----------------------------------------------------------------------------
# Requis sur Vercel : protège GET /api/cron/poller.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# Tarification et devises
# -----------------------------------------------------------------------------
# Taux de référence (repli si aucun taux en base).
EUR_XOF_RATE=655.957
USD_XOF_RATE=615
# Marge nette cible minimale par numéro, en XOF.
TARGET_MARGIN_XOF=2000
# Taux de commission de paiement (contrat FedaPay à confirmer).
PAYMENT_RATE_MOBILE_MONEY=0.018
PAYMENT_RATE_CARD=0.036
PAYMENT_RATE_WALLET=0
# Palier d'arrondi commercial, en XOF.
ROUNDING_STEP_XOF=100

# -----------------------------------------------------------------------------
# Limites et journaux
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
# En production, conserver les SMS selon la politique de rétention définie.
SMS_RETENTION_DAYS=30
