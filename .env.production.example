# =============================================================================
# Numivo — configuration de DÉPLOIEMENT (Vercel + Neon)
# Ce fichier est un modèle : les valeurs réelles se saisissent dans
# Vercel → Project → Settings → Environment Variables.
# Ne jamais committer de secret.
# Guide : DEPLOIEMENT-VERCEL-NEON.md
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Vercel force NODE_ENV=production sur les fonctions.
NODE_ENV=production
# staging = recette sans argent réel (mock autorisé, /api/dev accessible).
# production = environnement live (fournisseurs réels obligatoires).
APP_ENV=staging
APP_URL=https://numero-api.vercel.app
FRONTEND_URL=https://numero-pearl.vercel.app
# Origine exacte du front, sans slash final.
CORS_ORIGINS=https://numero-pearl.vercel.app
# 1 derrière le proxy Vercel.
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# PostgreSQL Neon
# -----------------------------------------------------------------------------
# URL applicative : hôte avec `-pooler`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# URL directe pour Prisma Migrate : même URL sans `-pooler`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# -----------------------------------------------------------------------------
# Authentification
# -----------------------------------------------------------------------------
# openssl rand -hex 64 (64 caractères minimum en production)
JWT_ACCESS_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_OCTETS_MINIMUM
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true

ADMIN_EMAIL=admin@numivo.local
# 12 caractères minimum en production. Générer : openssl rand -base64 24
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
ADMIN_NAME=Administrateur Numivo
ADMIN_COUNTRY=Bénin

# -----------------------------------------------------------------------------
# Poller planifié (cron Vercel)
# -----------------------------------------------------------------------------
# openssl rand -hex 32
CRON_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE

# -----------------------------------------------------------------------------
# Ultra SMS
# -----------------------------------------------------------------------------
# staging : mock. live : live + clé + secret de callback.
ULTRASMS_MODE=mock
ULTRASMS_API_KEY=
ULTRASMS_BASE_URL=https://ultrasmsin.com/api/v1
ULTRASMS_WEBHOOK_SECRET=
ULTRASMS_CALLBACK_URL=https://numero-api.vercel.app/api/webhooks/ultrasms
ULTRASMS_POLL_INTERVAL_MS=10000

# -----------------------------------------------------------------------------
# FedaPay
# -----------------------------------------------------------------------------
# staging : mock. Recette : sandbox. Encaissement réel : live.
PAYMENTS_MODE=mock
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Tarification et devises
# -----------------------------------------------------------------------------
EUR_XOF_RATE=655.957
USD_XOF_RATE=615
TARGET_MARGIN_XOF=2000
PAYMENT_RATE_MOBILE_MONEY=0.018
PAYMENT_RATE_CARD=0.036
PAYMENT_RATE_WALLET=0
ROUNDING_STEP_XOF=100

# -----------------------------------------------------------------------------
# Limites et journaux
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
SMS_RETENTION_DAYS=30
