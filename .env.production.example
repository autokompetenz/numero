# =============================================================================
# Numivo — configuration de PRODUCTION
# Copier en `.env.production`, renseigner les secrets, ne jamais committer.
# Déploiement : docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
PORT=4000
# Domaine public unique : Nginx sert le front et proxifie /api vers Express.
# HTTPS obligatoire (terminé par le reverse proxy placé devant le service web).
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
# Origine(s) exacte(s) du navigateur, séparées par des virgules.
CORS_ORIGINS=https://app.example.com
# 1 quand l'API est derrière le reverse proxy TLS (Nginx/Caddy/Traefik).
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# PostgreSQL (service `postgres` du compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=numivo
# openssl rand -base64 32
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
POSTGRES_DB=numivo
DATABASE_URL=postgresql://numivo:REMPLACER_PAR_UN_MOT_DE_PASSE_FORT@postgres:5432/numivo?schema=public

# -----------------------------------------------------------------------------
# Authentification
# -----------------------------------------------------------------------------
# openssl rand -hex 64 (64 octets minimum exigés en production)
JWT_ACCESS_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_OCTETS_MINIMUM
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true

ADMIN_EMAIL=admin@example.com
# 12 caractères minimum en production. Générer : openssl rand -base64 24
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT
ADMIN_NAME=Administrateur Numivo
ADMIN_COUNTRY=Bénin

# -----------------------------------------------------------------------------
# Ultra SMS — production
# -----------------------------------------------------------------------------
ULTRASMS_MODE=live
ULTRASMS_API_KEY=REMPLACER_PAR_LA_CLE_API_ULTRASMS
ULTRASMS_BASE_URL=https://ultrasmsin.com/api/v1
ULTRASMS_WEBHOOK_SECRET=REMPLACER_PAR_LE_SECRET_DU_CALLBACK
# URL publique HTTPS déclarée dans la console Ultra SMS.
ULTRASMS_CALLBACK_URL=https://app.example.com/api/webhooks/ultrasms/inbound
ULTRASMS_POLL_INTERVAL_MS=10000

# -----------------------------------------------------------------------------
# FedaPay — production (sandbox pour la recette, live pour l'encaissement)
# -----------------------------------------------------------------------------
PAYMENTS_MODE=sandbox
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# Webhook à déclarer dans le dashboard FedaPay : https://app.example.com/api/webhooks/fedapay

# -----------------------------------------------------------------------------
# Tarification et devises
# -----------------------------------------------------------------------------
EUR_XOF_RATE=655.957
USD_XOF_RATE=615
TARGET_MARGIN_XOF=2000
PAYMENT_RATE_MOBILE_MONEY=0.018
PAYMENT_RATE_CARD=0.036
PAYMENT_RATE_WALLET=0
ROUNDING_STEP_XOF=100

# -----------------------------------------------------------------------------
# Limites et journaux
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
SMS_RETENTION_DAYS=30
